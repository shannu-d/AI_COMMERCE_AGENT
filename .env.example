# =============================================================================
# Merchant AI Commerce Agent — environment template
#
# Copy to .env and fill in real values. .env is git-ignored and MUST NOT be
# committed. Every value below is a placeholder; none is a working credential.
#
# architecture.md L§45 and P§39 (RZP-01): secrets exist in the local
# environment, appear here without real values, are never committed, never
# exposed to frontend code, never returned in API responses, and never included
# in LLM prompts.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=local            # local | test | ci | production
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console           # console | json   (json in deployed environments)

# -----------------------------------------------------------------------------
# Browser access / CORS  (M14)
#
# The frontend runs on its own origin (Vite dev server on :5173) and this API on
# :8000, so without this list no browser can call the API at all.
#
# Comma-separated. Must be scheme://host[:port] - no trailing slash, no path,
# because a browser's Origin header never contains one. "*" is refused outright:
# session_id is the only thing distinguishing one buyer's cart from another's
# (ADR-017).
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database  (M0/M1)
#
# docker-compose.yml starts a matching PostgreSQL 16 instance.
# The driver is psycopg 3, hence the +psycopg suffix.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ai_commerce:ai_commerce@localhost:5432/ai_commerce
DB_ECHO=false

# Used only by the test suite. Point it at a throwaway database: the schema
# tests create and drop tables. Leave unset and the database-backed tests skip
# rather than run against DATABASE_URL by accident.
TEST_DATABASE_URL=postgresql+psycopg://ai_commerce:ai_commerce@localhost:5432/ai_commerce_test

# -----------------------------------------------------------------------------
# Catalog read services  (M2)
#
# The boundary between IN_STOCK and LOW_STOCK. ADR-009 names the three statuses
# without fixing where LOW_STOCK begins.
# -----------------------------------------------------------------------------
LOW_STOCK_THRESHOLD=5

# -----------------------------------------------------------------------------
# Ranking engine  (M3)
#
# R§17 RULE 14: the weights are configurable implementation parameters, not
# permanent business truths. The profiles themselves are data in
# app/ranking/weights.py; this chooses which one runs by default.
#
#   default              R§19's preferred set - preference .50 / price .30 / relevance .20
#   price_sensitive      R§12 "the cheapest compatible case"
#   premium              R§12 "price doesn't matter"
#   explainability_demo  R§4's four-weight presentation, incl. compatibility .40.
#                        Reproduces the R§10 worked example. Not for real
#                        recommendations.
#
# An unknown name is rejected at startup rather than falling back silently.
# -----------------------------------------------------------------------------
RANKING_PROFILE=default
RANKING_TOP_K=3              # RULE 11: "preferably Top 3", per requested product type

# -----------------------------------------------------------------------------
# Merchant scoping  (ADR-002)
#
# Resolved server-side and injected into every service call. Never read from
# model output and never taken from a client request.
#
# DEFAULT_MERCHANT_ID is derived deterministically from the merchant name by the
# seed loader, so the value below matches a seeded CircuitCraft catalog. Set it
# explicitly only when pointing at a differently-seeded database.
# -----------------------------------------------------------------------------
DEFAULT_MERCHANT_NAME=CircuitCraft
# DEFAULT_MERCHANT_ID=

# -----------------------------------------------------------------------------
# Groq  (M4 - ADR-018: Groq is the locked LLM provider)
#
# The key is read only by app/llm/client.py, which refuses to send a prompt
# containing any configured secret (L§45). No test needs a key: the model is
# faked at the LLMClient protocol, never at the network (ADR-015).
#
# GROQ_MODEL must be a real Groq model id. Verified available and tool-calling
# capable on this account: openai/gpt-oss-120b (an open-weights model served by
# Groq - no request goes to OpenAI).
#
# Retries apply to transient failures only - a timeout, a rate limit, a 5xx -
# with 0.5 x 2^n backoff. The SDK's own retry loop is disabled, so the policy is
# bounded once, not twice.
# -----------------------------------------------------------------------------
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Agent runtime  (M5 — not used before then)
# -----------------------------------------------------------------------------
MAX_TOOL_CALLS_PER_TURN=8    # ADR-009
AGENT_TRACE_ENABLED=false    # ADR-010: trace returned per turn, never persisted

# -----------------------------------------------------------------------------
# Policy engine  (M9 — not used before then)
# -----------------------------------------------------------------------------
SPENDING_LIMIT=10000.00      # ADR-011: per transaction, major units
SPENDING_LIMIT_CURRENCY=INR
APPROVAL_TTL_SECONDS=900     # ADR-007: 15 minutes
IDEMPOTENCY_TTL_SECONDS=86400  # ADR-013: 24 hours

# -----------------------------------------------------------------------------
# Razorpay Test Mode  (M11/M12 — not used before then)
#
# KEY_ID is public and is sent to the browser to open Checkout.
# KEY_SECRET and WEBHOOK_SECRET are server-side only. If either ever appears in
# an API response, a log line, or a prompt, that is a defect.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
