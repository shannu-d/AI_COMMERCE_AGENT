# ---------------------------------------------------------------------------
# Secrets — never commit real credentials.
# .env.example is the committed template and contains placeholders only.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Demo media. The screenshots in pitch-assets/ are committed; the walkthrough
# videos are not — website-demo.mp4 is 129 MB and GitHub rejects any file over
# 100 MB outright, so a push carrying it fails and has to be undone by
# rewriting history. The videos are shared out of band; see docs/SUBMISSION.md.
# ---------------------------------------------------------------------------
pitch-assets/*.mp4
pitch-assets/*.mov

# Database dumps. A dump of this database contains argon2 password digests and
# live bearer tokens (`users`, `auth_tokens`), so it is a credential store even
# though it is not a key file. Never commit one — see backups/README.md.
backups/*
!backups/README.md
*.dump
*.sql.gz

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Node / frontend (arrives at M14)
# ---------------------------------------------------------------------------
node_modules/
.next/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Databases — PostgreSQL is the source of truth and runs in a container.
# A local database file in this tree would mean something has gone wrong.
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
pgdata/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
scratch/
tmp/
*.log

# ---------------------------------------------------------------------------
# Claude Code — per-developer local settings are not shared
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Design reference material supplied for a task — working input, not source.
# ---------------------------------------------------------------------------
reference/
